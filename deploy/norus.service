[Unit]
Description=Grupo Norus (Daphne ASGI: HTTP + WebSockets)
After=network.target mysql.service

[Service]
User=ubuntu
WorkingDirectory=/srv/norus/backend/backend
EnvironmentFile=/srv/norus/backend/backend/.env
ExecStart=/srv/norus/backend/venv/bin/daphne -b 127.0.0.1 -p 8000 config.asgi:application
Restart=always

[Install]
WantedBy=multi-user.target
